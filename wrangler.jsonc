{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "tone-pick",
  "main": "src/server/index.ts",
  "compatibility_date": "2026-08-01",

  // 배포 주소: https://tone-pick.<계정>.workers.dev  (커스텀 도메인 불필요)
  "workers_dev": true,

  // 버전마다 생기는 미리보기 주소는 끈다. 같은 DO 를 물고 있어서, 옛 버전 주소로 들어오면
  // 옛 코드가 지금 데이터를 만진다 — 회차 하나를 여러 주소로 여는 이유가 없다.
  "preview_urls": false,

  // Vite 빌드 결과를 정적 자산으로. SPA 라우팅을 위해 404 는 index.html 로.
  // /api 와 /ws 는 정적 자산 매칭보다 Worker 가 먼저 봐야 한다 — 안 그러면 index.html 이 돌아온다.
  /*
   * 화면 상태를 URL 로 들고 있으므로(ROUTES.md) 어느 주소로 들어와도 index.html 이 떠야 한다.
   * 그게 single-page-application 의 일이다.
   *
   * ⚠️ 그런데 그 폴백은 **없는 자산에도 똑같이 걸린다.** 옛 index.html 을 들고 있는 브라우저가
   * 사라진 번들(/assets/index-옛해시.js)을 달라고 하면 HTML 이 200 으로 돌아오고,
   * 브라우저는 HTML 을 JS 모듈로 실행하지 않는다 — **JS 도 CSS 도 안 붙어 하얀 화면이 된다.**
   * 게다가 그 응답이 /assets/ 규칙을 타고 1년짜리 immutable 로 캐시된다.
   *
   * 그래서 /assets/* 는 워커가 먼저 받아 없으면 404 로 끊는다 (src/server/index.ts).
   * 404 는 브라우저가 "새로고침하면 되는 것" 으로 다루지만, HTML 200 은 그러지 못한다.
   */
  "assets": {
    "directory": "./dist/client",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*", "/ws/*", "/assets/*"]
  },

  // 회차 1개 = Durable Object 1개.
  // REGISTRY 는 회차 목록·입장 코드·공통 PIN 을 들고 있는 단 하나의 DO 다.
  // KV 를 쓰지 않는 이유: 쓰기 직후 읽기가 보장되지 않아 코드 중복·중복 생성이 실제로 날 수 있다.
  "durable_objects": {
    "bindings": [
      { "name": "EVENT", "class_name": "EventDO" },
      { "name": "REGISTRY", "class_name": "RegistryDO" }
    ]
  },
  // 무료 플랜에서 쓰려면 반드시 SQLite 백엔드로 마이그레이션해야 한다
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["EventDO", "RegistryDO"] }],

  /*
   * 운영 카운터. **회차 DO 밖에 쌓이는 유일한 자료다** — 무엇을 넣는지가 곧
   * 개인정보 경계라, 규칙은 `src/server/metrics.ts` 주석에 있다.
   * 운영 카운터는 넣고 결과 통계(매칭·콕·순위)는 넣지 않는다.
   */
  "analytics_engine_datasets": [{ "binding": "METRICS", "dataset": "tone_pick_ops" }],

  // 개인정보 파기. 04:00 KST — 파티가 도는 시간대를 피한다
  "triggers": { "crons": ["0 19 * * *"] },

  "observability": { "enabled": true },

  /*
   * 연습용 환경.  npm run deploy:qa  →  https://tone-pick-qa.<계정>.workers.dev
   *
   * 워커가 다르면 Durable Object 도 다르다. QA 의 회차·참가자·콕은 프로덕션과 완전히 분리되고,
   * 시크릿도 따로 넣는다. 그래서 100명 부하 리허설을 여기서 돌려도 진짜 파티 데이터가 안전하다.
   *
   * ENV_LABEL 이 있으면 화면 위에 띠가 뜬다. 파티 당일 운영자가 연습용 콘솔에서 단계를 넘기고
   * "참가자 화면이 왜 안 바뀌지?" 하는 사고를 막는 게 목적이다.
   *
   * ⚠️ durable_objects·assets·vars 는 환경에 상속되지 않는다. 위와 똑같이 적어줘야 한다.
   */
  "env": {
    "qa": {
      "name": "tone-pick-qa",
      "workers_dev": true,
      "preview_urls": false,
      /*
       * 연습용은 **비밀이 없는 환경**이다. 공통 PIN 은 언제나 0000 이고 여기 적혀 있다.
       *
       * 시크릿으로 두면 넣을 때마다 값이 흔들리고, 기억나지 않으면 다시 덮어써야 한다.
       * 연습용에 지킬 비밀이 없으니 설정에 박아 "항상 0000"을 구조로 만든다.
       *
       * ⚠️ 프로덕션에는 절대 이렇게 하지 마라. `npm run check` 가 막는다 (scripts/check-config.mjs).
       *    그래서 QA 에는 `wrangler secret put ... --env qa` 를 쓰지 않는다 — 여기 값과 충돌한다.
       *
       * 회차 PIN 을 0000 으로는 만들 수 없다. 공통 PIN 과 같아지는 걸 막기 때문이다 (ADR-3).
       */
      "vars": {
        "ENV_LABEL": "QA",
        "MASTER_PIN": "0000",
        "SESSION_SECRET": "qa-not-a-secret",
        // 오늘의 연애운. 키(OPENAI_API_KEY)는 시크릿으로만 넣는다 — 여기 적으면 그대로 공개된다
        "LLM_MODEL": "gpt-5.6-luna"
      },
      "analytics_engine_datasets": [{ "binding": "METRICS", "dataset": "tone_pick_ops_qa" }],
      "assets": {
        "directory": "./dist/client",
        "binding": "ASSETS",
        "not_found_handling": "single-page-application",
        "run_worker_first": ["/api/*", "/ws/*", "/assets/*"]
      },
      "durable_objects": {
        "bindings": [
          { "name": "EVENT", "class_name": "EventDO" },
          { "name": "REGISTRY", "class_name": "RegistryDO" }
        ]
      },
      "observability": { "enabled": true }
    }
  }
}
