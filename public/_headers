# 파일 이름에 내용 해시가 붙는 것만 영구 캐시한다.
#
# /assets/index-BasxnpK2.js 는 내용이 바뀌면 이름이 바뀐다. 그래서 한 번 받은 파일은
# 다시 확인할 이유가 없다. 기본값(max-age=0, must-revalidate)은 매번 왕복을 만드는데,
# 파티장 와이파이에서 100대가 접속하면 그 왕복이 100번이다.
#
# index.html 은 여기 넣지 않는다 — 배포 직후 새 화면을 받아야 하므로 매번 확인하는 게 맞다.
/assets/*
  Cache-Control: public, max-age=31536000, immutable

# 로고는 이름에 해시가 없지만 preload 로 **첫 그림의 조건**이 된 파일이다 (ADR-70).
# 기본값(max-age=0)이면 두 번째 방문부터도 304 왕복 뒤에야 뜬다 — preload 로 얻은 걸 도로 내준다.
#
# 하루는 묻지 않고 쓰고, 그 뒤 일주일은 **일단 그리고 뒤에서 새로 받는다**. 해시가 없으니
# immutable 은 못 쓴다 — 로고를 바꿨는데 영영 안 바뀌면 그게 더 나쁘다.
/logo.webp
  Cache-Control: public, max-age=86400, stale-while-revalidate=604800

# 글자체 (ADR-72). **이름이 곧 내용이다** — `SUIT-Regular.woff2` 는 그 폰트 그 굵기 하나만
# 가리키고, 다른 글자체로 바꾸면 파일 이름부터 달라진다. 해시가 붙은 것과 같은 성질이라
# 영구 캐시가 안전하다.
#
# preload 하지 않으므로 첫 그림을 막지는 않지만(`font-display: swap`), 두 번째 방문부터
# 왕복이 붙으면 **글자가 늦게 바뀌는 것이 그대로 보인다.**
/fonts/*
  Cache-Control: public, max-age=31536000, immutable
